<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Catálogo de Áreas y Ubicaciones</h2>
        <p class="text-muted mb-0">Gestión de departamentos, áreas operativas y sus ubicaciones (líneas, patios, etc.).</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaArea">
            <i class="bi bi-plus-lg"></i>
            <span>Nueva Área</span>
        </button>
    </div>
</div>

<%- include('../partials/alerts') %>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Nombre del Área</th>
                        <th>Descripción</th>
                        <th class="text-center">Estructura Operativa</th>
                        <th class="text-center">Estado</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (areas && areas.length > 0) { %>
                        <% areas.forEach(function(area) { %>
                            <tr>
                                <td class="ps-4 fw-bold text-primary"><%= area.codigo %></td>
                                <td>
                                    <span class="fw-semibold text-dark"><%= area.nombre %></span>
                                </td>
                                <td class="text-muted small"><%= area.descripcion || 'Sin descripción' %></td>
                                <td class="text-center">
                                    <div class="d-inline-flex flex-wrap justify-content-center gap-1">
                                        <!-- Badge Puestos -->
                                        <a href="/puestos?areaId=<%= area.id_area %>" 
                                           class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none px-2 py-1" 
                                           title="Ver puestos del área">
                                            <i class="bi bi-briefcase me-1"></i> <%= area.total_puestos %> puestos
                                        </a>
                                        <!-- Badge Ubicaciones -->
                                        <button type="button" 
                                                class="badge bg-warning-subtle text-dark border border-warning-subtle text-decoration-none px-2 py-1 btn btn-sm btn-manage-ubicaciones"
                                                data-id="<%= area.id_area %>" 
                                                data-nombre="<%= area.nombre %>" 
                                                title="Gestionar ubicaciones (ej. Arábiga, Robusta, Patios)">
                                            <i class="bi bi-geo-alt-fill text-warning me-1"></i> 
                                            <span id="badge-count-<%= area.id_area %>"><%= area.total_ubicaciones %></span> ubicaciones
                                        </button>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <% if (area.activa) { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactiva</span>
                                    <% } %>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Gestionar Ubicaciones -->
                                        <button type="button" 
                                                class="btn btn-outline-warning text-dark btn-manage-ubicaciones" 
                                                data-id="<%= area.id_area %>" 
                                                data-nombre="<%= area.nombre %>" 
                                                title="Administrar ubicaciones del área (Arábiga, Robusta, Patios)">
                                            <i class="bi bi-geo-alt"></i>
                                        </button>
                                        <!-- Ver Puestos -->
                                        <a href="/puestos?areaId=<%= area.id_area %>" class="btn btn-outline-secondary" title="Ver puestos del área">
                                            <i class="bi bi-briefcase"></i>
                                        </a>
                                        <!-- Editar Área -->
                                        <button type="button" class="btn btn-outline-primary btn-edit-area" 
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEditarArea"
                                                data-id="<%= area.id_area %>"
                                                data-codigo="<%= area.codigo %>"
                                                data-nombre="<%= area.nombre %>"
                                                data-descripcion="<%= area.descripcion || '' %>"
                                                data-activa="<%= area.activa ? '1' : '0' %>"
                                                title="Editar área">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <!-- Toggle Área -->
                                        <form action="/areas/toggle/<%= area.id_area %>" method="POST" class="d-inline">
                                            <button type="button" class="btn btn-outline-<%= area.activa ? 'warning' : 'success' %> btn-confirm-action" 
                                                    data-confirm-message="¿Desea <%= area.activa ? 'desactivar' : 'activar' %> esta área?"
                                                    title="<%= area.activa ? 'Desactivar área' : 'Activar área' %>">
                                                <i class="bi bi-<%= area.activa ? 'eye-slash' : 'check-circle' %>"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i> No hay áreas registradas. Crea la primera con el botón superior.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nueva Área -->
<div class="modal fade" id="modalNuevaArea" tabindex="-1" aria-labelledby="modalNuevaAreaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form action="/areas/crear" method="POST">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalNuevaAreaLabel"><i class="bi bi-plus-circle me-1"></i> Nueva Área</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="codigo" class="form-label fw-semibold">Código Único <span class="text-danger">*</span></label>
                        <input type="text" class="form-control text-uppercase" id="codigo" name="codigo" placeholder="Ej. PROD, SECADO, CALIDAD" required maxlength="20">
                        <small class="text-muted">Acrónimo o clave identificadora corta.</small>
                    </div>
                    <div class="mb-3">
                        <label for="nombre" class="form-label fw-semibold">Nombre del Área <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nombre" name="nombre" placeholder="Ej. Producción y Manufactura" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="descripcion" class="form-label fw-semibold">Descripción</label>
                        <textarea class="form-control" id="descripcion" name="descripcion" rows="3" placeholder="Breve descripción del alcance del área..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-semibold"><i class="bi bi-save me-1"></i> Guardar Área</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Área -->
<div class="modal fade" id="modalEditarArea" tabindex="-1" aria-labelledby="modalEditarAreaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form action="/areas/editar" method="POST">
                <input type="hidden" name="id_area" id="edit_id_area">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="modalEditarAreaLabel"><i class="bi bi-pencil-square me-1"></i> Editar Área</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="edit_codigo" class="form-label fw-semibold">Código Único <span class="text-danger">*</span></label>
                        <input type="text" class="form-control text-uppercase" id="edit_codigo" name="codigo" required maxlength="20">
                    </div>
                    <div class="mb-3">
                        <label for="edit_nombre" class="form-label fw-semibold">Nombre del Área <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="edit_nombre" name="nombre" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="edit_descripcion" class="form-label fw-semibold">Descripción</label>
                        <textarea class="form-control" id="edit_descripcion" name="descripcion" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="edit_activa" name="activa" value="1">
                        <label class="form-check-label fw-semibold" for="edit_activa">Área Activa</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-semibold"><i class="bi bi-check-lg me-1"></i> Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Administrador de Ubicaciones por Área -->
<div class="modal fade" id="modalUbicaciones" tabindex="-1" aria-labelledby="modalUbicacionesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="modalUbicacionesLabel">
                        <i class="bi bi-geo-alt-fill me-1"></i> Ubicaciones del Área: <span id="spanNombreAreaUbicacion" class="text-dark"></span>
                    </h5>
                    <small class="text-dark-50">Gestiona las ubicaciones operativas (ej. Arábiga, Robusta, Patios 1, 2, etc.)</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alertas dentro del modal -->
                <div id="modalUbicacionAlert" class="alert d-none py-2 px-3 small"></div>

                <!-- Formulario Agregar / Editar Ubicación -->
                <div class="card border border-warning-subtle bg-light mb-4">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-2 text-dark" id="formUbicacionTitle">
                            <i class="bi bi-plus-circle me-1 text-warning"></i> Agregar Nueva Ubicación
                        </h6>
                        <form id="formUbicacion" class="row g-2 align-items-end">
                            <input type="hidden" id="ub_id_area" name="id_area">
                            <input type="hidden" id="ub_id_ubicacion" name="id_ubicacion">
                            
                            <div class="col-md-3">
                                <label for="ub_codigo" class="form-label small fw-semibold mb-1">Código Único *</label>
                                <input type="text" class="form-control form-control-sm text-uppercase" id="ub_codigo" name="codigo" placeholder="Ej. ARABIGA, PATIO1" required maxlength="30">
                            </div>
                            <div class="col-md-4">
                                <label for="ub_nombre" class="form-label small fw-semibold mb-1">Nombre Ubicación *</label>
                                <input type="text" class="form-control form-control-sm" id="ub_nombre" name="nombre" placeholder="Ej. ARÁBIGA o Patio 1" required maxlength="100">
                            </div>
                            <div class="col-md-3">
                                <label for="ub_descripcion" class="form-label small fw-semibold mb-1">Descripción</label>
                                <input type="text" class="form-control form-control-sm" id="ub_descripcion" name="descripcion" placeholder="Detalle opcional...">
                            </div>
                            <div class="col-md-2 d-flex gap-1">
                                <button type="submit" class="btn btn-sm btn-primary w-100 fw-semibold" id="btnGuardarUbicacion">
                                    <i class="bi bi-save me-1"></i> Guardar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelarEdicionUb" title="Cancelar edición">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Tabla de Ubicaciones Existentes -->
                <h6 class="fw-bold mb-2 text-dark d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-list-ul me-1"></i> Ubicaciones Registradas</span>
                    <span id="loaderUbicaciones" class="spinner-border spinner-border-sm text-primary d-none" role="status"></span>
                </h6>
                <div class="table-responsive border rounded-3 bg-white">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th class="ps-3">Código</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th class="text-center">Estado</th>
                                <th class="pe-3 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyUbicaciones">
                            <!-- Se carga dinámicamente -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Modal Editar Área
    const editAreaModal = new bootstrap.Modal(document.getElementById('modalEditarArea'));
    document.querySelectorAll('.btn-edit-area').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('edit_id_area').value = btn.getAttribute('data-id');
            document.getElementById('edit_codigo').value = btn.getAttribute('data-codigo');
            document.getElementById('edit_nombre').value = btn.getAttribute('data-nombre');
            document.getElementById('edit_descripcion').value = btn.getAttribute('data-descripcion');
            document.getElementById('edit_activa').checked = btn.getAttribute('data-activa') === '1';
            editAreaModal.show();
        });
    });

    // 2. Modal Gestionar Ubicaciones
    const ubicacionesModal = new bootstrap.Modal(document.getElementById('modalUbicaciones'));
    const spanNombreArea = document.getElementById('spanNombreAreaUbicacion');
    const inputIdArea = document.getElementById('ub_id_area');
    const inputIdUb = document.getElementById('ub_id_ubicacion');
    const inputCodigo = document.getElementById('ub_codigo');
    const inputNombre = document.getElementById('ub_nombre');
    const inputDesc = document.getElementById('ub_descripcion');
    const btnGuardarUb = document.getElementById('btnGuardarUbicacion');
    const btnCancelarUb = document.getElementById('btnCancelarEdicionUb');
    const formUbTitle = document.getElementById('formUbicacionTitle');
    const tbodyUb = document.getElementById('tbodyUbicaciones');
    const loaderUb = document.getElementById('loaderUbicaciones');
    const alertUb = document.getElementById('modalUbicacionAlert');

    let currentAreaId = null;

    function showAlert(msg, type = 'success') {
        alertUb.className = `alert alert-${type} py-2 px-3 small`;
        alertUb.textContent = msg;
        alertUb.classList.remove('d-none');
        setTimeout(() => alertUb.classList.add('d-none'), 4000);
    }

    function resetFormUb() {
        inputIdUb.value = '';
        inputCodigo.value = '';
        inputNombre.value = '';
        inputDesc.value = '';
        formUbTitle.innerHTML = '<i class="bi bi-plus-circle me-1 text-warning"></i> Agregar Nueva Ubicación';
        btnGuardarUb.innerHTML = '<i class="bi bi-save me-1"></i> Guardar';
        btnCancelarUb.classList.add('d-none');
    }

    btnCancelarUb.addEventListener('click', resetFormUb);

    async function loadUbicaciones(areaId) {
        loaderUb.classList.remove('d-none');
        tbodyUb.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Cargando ubicaciones...</td></tr>';

        try {
            const resp = await fetch(`/api/areas/${areaId}/ubicaciones`);
            const data = await resp.json();

            loaderUb.classList.add('d-none');

            if (!data.success || !data.ubicaciones || data.ubicaciones.length === 0) {
                tbodyUb.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-geo-alt fs-3 d-block mb-1 text-secondary"></i>
                            Esta área no tiene ubicaciones aún. Agrega la primera arriba (ej. ARÁBIGA, ROBUSTA, Patio 1).
                        </td>
                    </tr>
                `;
                const badgeCount = document.getElementById(`badge-count-${areaId}`);
                if (badgeCount) badgeCount.textContent = '0';
                return;
            }

            const badgeCount = document.getElementById(`badge-count-${areaId}`);
            if (badgeCount) {
                const totalActivas = data.ubicaciones.filter(u => u.activa).length;
                badgeCount.textContent = totalActivas;
            }

            let html = '';
            data.ubicaciones.forEach(u => {
                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-primary small">${u.codigo}</td>
                        <td class="fw-semibold text-dark small">${u.nombre}</td>
                        <td class="text-muted small">${u.descripcion || '-'}</td>
                        <td class="text-center">
                            <span class="badge ${u.activa ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle'}">
                                ${u.activa ? 'Activa' : 'Inactiva'}
                            </span>
                        </td>
                        <td class="pe-3 text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary btn-edit-ub" 
                                        data-id="${u.id_ubicacion}" 
                                        data-codigo="${u.codigo}" 
                                        data-nombre="${u.nombre}" 
                                        data-desc="${u.descripcion || ''}" 
                                        title="Editar ubicación">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-${u.activa ? 'warning' : 'success'} btn-toggle-ub" 
                                        data-id="${u.id_ubicacion}" 
                                        data-nombre="${u.nombre}" 
                                        title="${u.activa ? 'Desactivar' : 'Activar'}">
                                    <i class="bi bi-${u.activa ? 'eye-slash' : 'check-circle'}"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tbodyUb.innerHTML = html;

            // Vincular botones de edición dentro del modal
            tbodyUb.querySelectorAll('.btn-edit-ub').forEach(b => {
                b.addEventListener('click', () => {
                    inputIdUb.value = b.getAttribute('data-id');
                    inputCodigo.value = b.getAttribute('data-codigo');
                    inputNombre.value = b.getAttribute('data-nombre');
                    inputDesc.value = b.getAttribute('data-desc');
                    formUbTitle.innerHTML = `<i class="bi bi-pencil-square me-1 text-primary"></i> Editando: <strong>${b.getAttribute('data-nombre')}</strong>`;
                    btnGuardarUb.innerHTML = '<i class="bi bi-check-lg me-1"></i> Actualizar';
                    btnCancelarUb.classList.remove('d-none');
                    inputNombre.focus();
                });
            });

            // Vincular botones de toggle
            tbodyUb.querySelectorAll('.btn-toggle-ub').forEach(b => {
                b.addEventListener('click', async () => {
                    const uId = b.getAttribute('data-id');
                    try {
                        const toggleResp = await fetch(`/ubicaciones/toggle/${uId}`, {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' }
                        });
                        const toggleData = await toggleResp.json();
                        if (toggleData.success) {
                            showAlert(toggleData.message, 'success');
                            loadUbicaciones(currentAreaId);
                        } else {
                            showAlert(toggleData.message || 'Error al cambiar estado.', 'danger');
                        }
                    } catch (e) {
                        showAlert('Error de conexión al cambiar estado.', 'danger');
                    }
                });
            });

        } catch (err) {
            loaderUb.classList.add('d-none');
            tbodyUb.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Error al cargar ubicaciones.</td></tr>';
        }
    }

    // Al abrir el modal desde cualquier botón de área
    document.querySelectorAll('.btn-manage-ubicaciones').forEach(btn => {
        btn.addEventListener('click', () => {
            currentAreaId = btn.getAttribute('data-id');
            const areaNombre = btn.getAttribute('data-nombre');
            spanNombreArea.textContent = areaNombre;
            inputIdArea.value = currentAreaId;
            resetFormUb();
            ubicacionesModal.show();
            loadUbicaciones(currentAreaId);
        });
    });

    // Guardar o Editar Ubicación vía AJAX
    document.getElementById('formUbicacion').addEventListener('submit', async (e) => {
        e.preventDefault();
        const uId = inputIdUb.value;
        const url = uId ? '/ubicaciones/editar' : '/ubicaciones/crear';
        const bodyPayload = {
            id_area: inputIdArea.value,
            id_ubicacion: uId,
            codigo: inputCodigo.value.trim(),
            nombre: inputNombre.value.trim(),
            descripcion: inputDesc.value.trim()
        };

        try {
            btnGuardarUb.disabled = true;
            const resp = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(bodyPayload)
            });
            const resJson = await resp.json();
            btnGuardarUb.disabled = false;

            if (resJson.success) {
                showAlert(resJson.message, 'success');
                resetFormUb();
                loadUbicaciones(currentAreaId);
            } else {
                showAlert(resJson.message || 'Error al guardar.', 'danger');
            }
        } catch (err) {
            btnGuardarUb.disabled = false;
            showAlert('Error de red al procesar la solicitud.', 'danger');
        }
    });
});
</script>
