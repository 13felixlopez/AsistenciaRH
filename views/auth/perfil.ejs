<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center p-4">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow mb-3" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">
                    <%= user.nombre.charAt(0).toUpperCase() %>
                </div>
                <h4 class="fw-bold mb-1"><%= user.nombre %></h4>
                <p class="text-muted mb-2"><%= user.cargo || 'Sin cargo especificado' %></p>
                <span class="badge <%= user.rol_codigo === 'ADMIN' ? 'bg-danger' : 'bg-primary' %> px-3 py-2 fs-6">
                    <%= user.rol_nombre %>
                </span>

                <hr class="my-4">

                <div class="text-start">
                    <div class="mb-3">
                        <small class="text-muted d-block">Nombre de Usuario</small>
                        <span class="fw-semibold text-dark"><i class="bi bi-person-badge me-1 text-primary"></i> @<%= user.usuario %></span>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Correo Electrónico</small>
                        <span class="fw-semibold text-dark"><i class="bi bi-envelope me-1 text-primary"></i> <%= user.email %></span>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Fecha de Alta</small>
                        <span class="fw-semibold text-dark"><i class="bi bi-calendar-event me-1 text-primary"></i> <%= new Date(user.fecha_creacion).toLocaleDateString() %></span>
                    </div>
                    <div>
                        <small class="text-muted d-block">Último Acceso</small>
                        <span class="fw-semibold text-dark"><i class="bi bi-clock-history me-1 text-primary"></i> <%= user.ultimo_acceso ? new Date(user.ultimo_acceso).toLocaleString() : 'Reciente' %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-lock text-primary me-2"></i> Cambiar Mi Contraseña</h5>
            </div>
            <div class="card-body p-4">
                <form action="/auth/perfil/password" method="POST">
                    <div class="mb-3">
                        <label for="actualPassword" class="form-label fw-semibold">Contraseña Actual</label>
                        <input type="password" class="form-control" id="actualPassword" name="actualPassword" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="newPassword" class="form-label fw-semibold">Nueva Contraseña</label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6">
                            <div class="form-text">Mínimo 6 caracteres.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="confirmPassword" class="form-label fw-semibold">Confirmar Nueva Contraseña</label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="6">
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Actualizar Contraseña
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-diagram-3 text-success me-2"></i> Mis Áreas Asignadas</h5>
            </div>
            <div class="card-body p-4">
                <% if (user.rol_codigo === 'ADMIN') { %>
                    <div class="alert alert-info d-flex align-items-center mb-0">
                        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                        <div>
                            <strong>Acceso Total como Administrador:</strong> Puedes ver, registrar y gestionar todas las áreas y puestos de la organización sin restricciones.
                        </div>
                    </div>
                <% } else if (areasAsignadas && areasAsignadas.length > 0) { %>
                    <p class="text-muted mb-3">Tienes acceso autorizado a las siguientes áreas de trabajo:</p>
                    <div class="list-group">
                        <% areasAsignadas.forEach(function(a) { %>
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0 fw-bold"><i class="bi bi-building me-2 text-primary"></i> <%= a.nombre %></h6>
                                </div>
                                <div class="d-flex gap-2">
                                    <% if (a.permite_registro) { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Permite Registrar</span>
                                    <% } %>
                                    <% if (a.permite_reportes) { %>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Permite Reportes</span>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-circle me-1"></i> Aún no tienes áreas asignadas. Solicita acceso a un Administrador.
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
