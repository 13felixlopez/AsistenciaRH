<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Historial de Asistencias</h2>
        <p class="text-muted mb-0">Consulta y seguimiento de todos los registros de asistencia realizados por área y ubicación.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/asistencias/registro" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-pencil-square"></i>
            <span>Nuevo Registro</span>
        </a>
    </div>
</div>

<%- include('../partials/alerts') %>

<!-- Filtros de Búsqueda -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3 p-md-4">
        <form action="/asistencias/historial" method="GET" class="row g-3">
            <div class="col-12 col-md-3">
                <label for="fechaInicio" class="form-label fw-semibold text-secondary small">
                    <i class="bi bi-calendar-event me-1"></i> Fecha Inicial:
                </label>
                <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" value="<%= fechaInicio %>">
            </div>

            <div class="col-12 col-md-3">
                <label for="fechaFin" class="form-label fw-semibold text-secondary small">
                    <i class="bi bi-calendar-check me-1"></i> Fecha Final:
                </label>
                <input type="date" class="form-control" id="fechaFin" name="fechaFin" value="<%= fechaFin %>">
            </div>

            <div class="col-12 col-md-3">
                <label for="areaId" class="form-label fw-semibold text-secondary small">
                    <i class="bi bi-building me-1"></i> Área Operativa:
                </label>
                <select name="areaId" id="areaId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todas las Áreas --</option>
                    <% areas.forEach(function(a) { %>
                        <option value="<%= a.id_area %>" <%= selectedAreaId === a.id_area ? 'selected' : '' %>>
                            <%= a.nombre %> (<%= a.codigo %>)
                        </option>
                    <% }); %>
                </select>
            </div>

            <% if (ubicacionesFiltro && ubicacionesFiltro.length > 0) { %>
                <div class="col-12 col-md-3">
                    <label for="ubicacionId" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-geo-alt-fill me-1 text-warning"></i> Ubicación / Línea:
                    </label>
                    <select name="ubicacionId" id="ubicacionId" class="form-select border-warning" onchange="this.form.submit()">
                        <option value="">-- Todas las Ubicaciones --</option>
                        <% ubicacionesFiltro.forEach(function(u) { %>
                            <option value="<%= u.id_ubicacion %>" <%= selectedUbicacionId === u.id_ubicacion ? 'selected' : '' %>>
                                <%= u.nombre %>
                            </option>
                        <% }); %>
                    </select>
                </div>
            <% } %>

            <div class="col-12 col-md-<%= (ubicacionesFiltro && ubicacionesFiltro.length > 0) ? '12' : '3' %> d-flex align-items-end justify-content-end gap-2">
                <a href="/asistencias/historial" class="btn btn-outline-secondary">Limpiar</a>
                <button type="submit" class="btn btn-primary fw-semibold">
                    <i class="bi bi-search me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Resumen de Métricas del Filtro -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body p-3">
                <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Total Registros</small>
                <span class="fs-4 fw-bold text-dark"><%= totales.registros %></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body p-3">
                <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Total Asistentes</small>
                <span class="fs-4 fw-bold text-success"><%= totales.personas %></span>
            </div>
        </div>
    </div>
</div>

<!-- Tabla Detallada de Asistencias -->
<div class="card shadow-sm border-0 mb-5">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Área / Ubicación</th>
                        <th>Puesto / Turno</th>
                        <th class="text-center">Asistentes</th>
                        <th>Observaciones</th>
                        <th>Capturado Por</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (asistencias && asistencias.length > 0) { %>
                        <% asistencias.forEach(function(item) { %>
                            <tr>
                                <td class="ps-4">
                                    <% 
                                        const dItem = new Date(item.fecha);
                                        const fechaStr = `${String(dItem.getDate()).padStart(2, '0')}/${String(dItem.getMonth() + 1).padStart(2, '0')}/${dItem.getFullYear()}`;
                                        const fechaRawStr = `${dItem.getFullYear()}-${String(dItem.getMonth()+1).padStart(2,'0')}-${String(dItem.getDate()).padStart(2,'0')}`;
                                        const dHoy = new Date();
                                        const fechaHoyRaw = `${dHoy.getFullYear()}-${String(dHoy.getMonth()+1).padStart(2,'0')}-${String(dHoy.getDate()).padStart(2,'0')}`;
                                        const esHoy = fechaRawStr === fechaHoyRaw;
                                    %>
                                    <div class="fw-bold text-dark"><%= fechaStr %></div>
                                    <small class="text-muted"><%= item.fecha_registro_texto ? item.fecha_registro_texto.split(' ')[0] : '' %></small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark"><%= item.area_nombre %></div>
                                    <% if (item.ubicacion_nombre) { %>
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle" style="font-size: 0.72rem;">
                                            <i class="bi bi-geo-alt-fill text-warning me-1"></i><%= item.ubicacion_nombre %>
                                        </span>
                                    <% } else { %>
                                        <small class="text-muted">Área General</small>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center flex-wrap gap-1">
                                        <span class="fw-bold text-dark"><%= item.puesto_nombre %></span>
                                        <% if (item.turno === 'TURNO_1') { %>
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle" style="font-size: 0.7rem;">
                                                <i class="bi bi-sun-fill text-warning me-1"></i>Turno 1
                                            </span>
                                        <% } else if (item.turno === 'TURNO_2') { %>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.7rem;">
                                                <i class="bi bi-moon-stars-fill me-1"></i>Turno 2
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.7rem;">
                                                Turno Único
                                            </span>
                                        <% } %>
                                    </div>
                                    <% if (item.cantidad_contratada > 0) { %>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">
                                            Tope contratado: <%= item.cantidad_contratada %> personas
                                        </small>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-1">
                                        <i class="bi bi-people me-1"></i> <%= item.cantidad_asistentes %>
                                    </span>
                                </td>
                                <td class="small text-muted"><%= item.observaciones || '-' %></td>
                                <td class="small text-muted">
                                    <div><i class="bi bi-person me-1"></i> <%= item.registrado_por || '-' %></div>
                                    <% if (item.hora_registro_texto) { %>
                                        <div style="font-size: 0.72rem;" class="text-secondary opacity-75">
                                            <i class="bi bi-clock me-1"></i><%= item.hora_registro_texto %>
                                        </div>
                                    <% } %>
                                    <% if (item.modificado_por) { %>
                                        <div style="font-size: 0.7rem;" class="text-danger mt-1">
                                            <i class="bi bi-pencil-fill me-1"></i>Modificado por: <%= item.modificado_por %>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group btn-group-sm">
                                        <% if (isAdmin) { %>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-corregir-asistencia" 
                                                    data-id="<%= item.id_asistencia %>"
                                                    data-fecha="<%= fechaStr %>"
                                                    data-area="<%= item.area_nombre %>"
                                                    data-ubicacion="<%= item.ubicacion_nombre || 'Área General' %>"
                                                    data-puesto="<%= item.puesto_nombre %>"
                                                    data-turno="<%= item.turno %>"
                                                    data-cantidad="<%= item.cantidad_asistentes %>"
                                                    data-max="<%= item.cantidad_contratada || 0 %>"
                                                    data-obs="<%= item.observaciones || '' %>"
                                                    title="Corregir asistencia como Administrador">
                                                <i class="bi bi-pencil-square me-1"></i> Corregir
                                            </button>
                                        <% } %>
                                        <% if (esHoy) { %>
                                            <a href="/asistencias/registro?areaId=<%= item.id_area %><%= item.id_ubicacion ? '&ubicacionId=' + item.id_ubicacion : '' %>" 
                                               class="btn btn-sm btn-outline-primary" 
                                               title="Ir a captura del día">
                                                <i class="bi bi-arrow-right-circle me-1"></i> Registro
                                            </a>
                                        <% } else if (!isAdmin) { %>
                                            <span class="badge bg-light text-secondary border" title="Esta fecha ya concluyó">
                                                <i class="bi bi-lock-fill me-1"></i>Cerrada
                                            </span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i> No se encontraron registros de asistencias para el rango seleccionado.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Corregir Asistencia (Exclusivo Admin) -->
<div class="modal fade" id="modalCorregirAsistencia" tabindex="-1" aria-labelledby="modalCorregirLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form action="/asistencias/corregir" method="POST" id="formCorregirAsistencia">
                <input type="hidden" name="id_asistencia" id="corregir_id_asistencia">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalCorregirLabel">
                        <i class="bi bi-shield-lock-fill me-1"></i> Corregir Registro de Asistencia
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border mb-3 small">
                        <div class="row g-2">
                            <div class="col-6"><strong>Fecha:</strong> <span id="spanCorregirFecha">-</span></div>
                            <div class="col-6"><strong>Área:</strong> <span id="spanCorregirArea">-</span></div>
                            <div class="col-6"><strong>Ubicación:</strong> <span id="spanCorregirUbicacion">-</span></div>
                            <div class="col-6"><strong>Turno:</strong> <span id="spanCorregirTurno">-</span></div>
                            <div class="col-12 border-top pt-1 mt-1"><strong>Puesto:</strong> <span id="spanCorregirPuesto" class="text-primary fw-bold">-</span></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="corregir_cantidad" class="form-label fw-bold text-dark">
                            Cantidad Real de Asistentes <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-people-fill"></i></span>
                            <input type="number" class="form-control form-control-lg fw-bold text-center fs-4" id="corregir_cantidad" name="cantidad_asistentes" min="0" max="500" required>
                        </div>
                        <small class="text-muted d-block mt-1" id="helpCorregirPlantilla"></small>
                    </div>

                    <div class="mb-3">
                        <label for="corregir_observaciones" class="form-label fw-semibold text-secondary small">
                            Motivo de la Corrección / Observaciones
                        </label>
                        <textarea class="form-control" id="corregir_observaciones" name="observaciones" rows="3" placeholder="Ej. Corrección por error de captura del turno..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-semibold" id="btnSubmitCorregir">
                        <i class="bi bi-check-circle me-1"></i> Guardar Corrección
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modalEl = document.getElementById('modalCorregirAsistencia');
    if (!modalEl) return;
    const modalInstance = new bootstrap.Modal(modalEl);
    let maxContratados = 0;

    document.querySelectorAll('.btn-corregir-asistencia').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const fecha = btn.getAttribute('data-fecha');
            const area = btn.getAttribute('data-area');
            const ubicacion = btn.getAttribute('data-ubicacion');
            const puesto = btn.getAttribute('data-puesto');
            const turno = btn.getAttribute('data-turno');
            const cantidad = btn.getAttribute('data-cantidad');
            const max = parseInt(btn.getAttribute('data-max'), 10) || 0;
            const obs = btn.getAttribute('data-obs');

            maxContratados = max;
            document.getElementById('corregir_id_asistencia').value = id;
            document.getElementById('spanCorregirFecha').textContent = fecha;
            document.getElementById('spanCorregirArea').textContent = area;
            document.getElementById('spanCorregirUbicacion').textContent = ubicacion;
            document.getElementById('spanCorregirTurno').textContent = turno;
            document.getElementById('spanCorregirPuesto').textContent = puesto;
            document.getElementById('corregir_cantidad').value = cantidad;
            document.getElementById('corregir_observaciones').value = obs;

            const helpText = document.getElementById('helpCorregirPlantilla');
            const inputCant = document.getElementById('corregir_cantidad');
            if (max > 0) {
                inputCant.max = max;
                helpText.innerHTML = `<i class="bi bi-info-circle me-1 text-primary"></i>Plantilla autorizada para este puesto: <strong>${max} personas</strong> (tope máximo).`;
            } else {
                inputCant.removeAttribute('max');
                helpText.textContent = '';
            }

            modalInstance.show();
        });
    });

    document.getElementById('formCorregirAsistencia').addEventListener('submit', (e) => {
        const val = parseInt(document.getElementById('corregir_cantidad').value, 10);
        if (maxContratados > 0 && val > maxContratados) {
            e.preventDefault();
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Límite Excedido',
                    text: `La cantidad (${val}) no puede sobrepasar el personal contratado (${maxContratados}).`,
                    icon: 'warning',
                    confirmButtonColor: '#D83548'
                });
            } else {
                alert(`La cantidad (${val}) no puede sobrepasar el personal contratado (${maxContratados}).`);
            }
        }
    });
});
</script>
