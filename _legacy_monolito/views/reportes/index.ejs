<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Centro de Reportes Estadísticos</h2>
        <p class="text-muted mb-0">Análisis cuantitativo de personal por puesto, ubicación, área y tendencias temporales.</p>
    </div>
    <div class="d-flex gap-2">
        <!-- Botón Exportar a Excel -->
        <a href="/reportes/exportar/excel?tipo=<%= tipoReporte %>&fechaInicio=<%= fechaInicio %>&fechaFin=<%= fechaFin %>&fechaDiario=<%= fechaDiario %>&areaId=<%= selectedAreaId || '' %>&ubicacionId=<%= selectedUbicacionId || '' %>&puestoId=<%= selectedPuestoId || '' %>" 
           class="btn btn-success d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-excel-fill"></i>
            <span>Exportar a Excel</span>
        </a>
        <!-- Botón Imprimir / PDF -->
        <button type="button" class="btn btn-outline-dark d-flex align-items-center gap-2" onclick="window.print()">
            <i class="bi bi-printer"></i>
            <span class="d-none d-sm-inline">Imprimir / PDF</span>
        </button>
    </div>
</div>

<%- include('../partials/alerts') %>

<!-- Filtros de Reporte -->
<div class="card shadow-sm border-0 mb-4 no-print">
    <div class="card-header bg-white py-3 border-bottom">
        <div class="nav nav-pills card-header-pills" id="reportTabs" role="tablist">
            <a class="nav-link <%= tipoReporte === 'comparativa' ? 'active' : '' %>" href="/reportes?tipo=comparativa">
                <i class="bi bi-bar-chart-steps me-1"></i> Comparativa Plantilla vs Asistencia
            </a>
            <a class="nav-link <%= tipoReporte === 'detalle_puesto' ? 'active' : '' %>" href="/reportes?tipo=detalle_puesto">
                <i class="bi bi-people-fill me-1"></i> Asistencia por Puestos & Tendencias
            </a>
            <a class="nav-link <%= tipoReporte === 'resumen_area' ? 'active' : '' %>" href="/reportes?tipo=resumen_area">
                <i class="bi bi-pie-chart me-1"></i> Resumen & Evolución por Área
            </a>
            <a class="nav-link <%= tipoReporte === 'diario' ? 'active' : '' %>" href="/reportes?tipo=diario">
                <i class="bi bi-calendar-day me-1"></i> Reporte Diario Consolidado
            </a>
        </div>
    </div>

    <div class="card-body p-4">
        <form action="/reportes" method="GET" class="row g-3 align-items-end" id="formReportes">
            <input type="hidden" name="tipo" value="<%= tipoReporte %>">

            <% if (tipoReporte === 'diario' || tipoReporte === 'comparativa') { %>
                <div class="col-md-2">
                    <label for="fechaDiario" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-calendar-event me-1"></i> <%= tipoReporte === 'comparativa' ? 'Fecha Evaluación:' : 'Fecha Específica:' %>
                    </label>
                    <input type="date" class="form-control" id="fechaDiario" name="fechaDiario" value="<%= fechaDiario %>" required>
                </div>
            <% } else { %>
                <div class="col-md-2">
                    <label for="fechaInicio" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-calendar-plus me-1"></i> Fecha Inicial:
                    </label>
                    <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" value="<%= fechaInicio %>" required>
                </div>
                <div class="col-md-2">
                    <label for="fechaFin" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-calendar-check me-1"></i> Fecha Final:
                    </label>
                    <input type="date" class="form-control" id="fechaFin" name="fechaFin" value="<%= fechaFin %>" required>
                </div>
            <% } %>

            <!-- Selector de Área -->
            <div class="col-md-3">
                <label for="areaId" class="form-label fw-semibold text-secondary small">
                    <i class="bi bi-building me-1"></i> Área Operativa:
                </label>
                <select name="areaId" id="areaId" class="form-select" onchange="document.getElementById('formReportes').submit()">
                    <% if (areas.length > 1) { %>
                        <option value="">-- Todas mis Áreas --</option>
                    <% } %>
                    <% areas.forEach(function(a) { %>
                        <option value="<%= a.id_area %>" <%= (selectedAreaId === a.id_area || areas.length === 1) ? 'selected' : '' %>>
                            <%= a.nombre %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <% if (tipoReporte !== 'comparativa') { %>
            <!-- Selector de Ubicación -->
            <div class="col-md-2">
                <label for="ubicacionId" class="form-label fw-semibold text-secondary small">
                    <i class="bi bi-geo-alt-fill me-1 text-warning"></i> Ubicación / Patio:
                </label>
                <select name="ubicacionId" id="ubicacionId" class="form-select" <%= (!ubicacionesFiltro || ubicacionesFiltro.length === 0) ? 'disabled' : '' %> onchange="document.getElementById('formReportes').submit()">
                    <option value="">-- Todas las Ubicaciones --</option>
                    <% if (ubicacionesFiltro && ubicacionesFiltro.length > 0) { %>
                        <% ubicacionesFiltro.forEach(function(u) { %>
                            <option value="<%= u.id_ubicacion %>" <%= selectedUbicacionId === u.id_ubicacion ? 'selected' : '' %>>
                                <%= u.nombre %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <% } %>

            <!-- Selector de Puesto de Trabajo -->
            <div class="<%= tipoReporte === 'comparativa' ? 'col-md-4' : 'col-md-2' %>">
                <label for="puestoId" class="form-label fw-semibold text-secondary small">
                    <i class="bi bi-person-workspace me-1 text-primary"></i> Puesto:
                </label>
                <select name="puestoId" id="puestoId" class="form-select">
                    <option value="">-- Todos los Puestos --</option>
                    <% if (puestosFiltro && puestosFiltro.length > 0) { %>
                        <% puestosFiltro.forEach(function(p) { %>
                            <option value="<%= p.id_puesto %>" <%= selectedPuestoId === p.id_puesto ? 'selected' : '' %>>
                                <%= p.nombre %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <!-- Botón Generar -->
            <div class="<%= tipoReporte === 'comparativa' ? 'col-md-3' : 'col-md-1' %>">
                <button type="submit" class="btn btn-primary w-100 fw-semibold px-2 d-flex align-items-center justify-content-center gap-2" title="Aplicar filtros">
                    <i class="bi bi-funnel-fill"></i>
                    <span><%= tipoReporte === 'comparativa' ? 'Generar Comparativa' : 'Filtrar' %></span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tarjetas de Totales -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Total Asistieron</span>
                    <h3 class="fw-bold my-1 text-primary"><%= totales.personas %></h3>
                    <small class="text-muted"><%= tipoReporte === 'diario' ? 'Presentes en la jornada' : 'Asistencias acumuladas' %></small>
                </div>
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card stat-teal">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Plantilla Contratada</span>
                    <h3 class="fw-bold my-1 text-teal"><%= totales.totalContratados %></h3>
                    <small class="text-muted">Dotación autorizada</small>
                </div>
                <div class="stat-icon bg-teal-subtle text-teal">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card <%= tipoReporte === 'comparativa' ? (totales.diferenciaNeta < 0 ? 'stat-danger' : (totales.diferenciaNeta > 0 ? 'stat-teal' : 'stat-success')) : 'stat-danger' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">
                        <%= tipoReporte === 'comparativa' ? 'Diferencia (Variación)' : 'Faltantes / Ausencias' %>
                    </span>
                    <h3 class="fw-bold my-1 <%= tipoReporte === 'comparativa' ? (totales.diferenciaNeta < 0 ? 'text-danger' : (totales.diferenciaNeta > 0 ? 'text-primary' : 'text-success')) : 'text-danger' %>">
                        <%= tipoReporte === 'comparativa' ? (totales.diferenciaNeta > 0 ? '+' + totales.diferenciaNeta : totales.diferenciaNeta) : totales.faltantes %>
                    </h3>
                    <small class="text-muted">
                        <%= tipoReporte === 'comparativa' ? (totales.diferenciaNeta < 0 ? 'Personas faltantes' : (totales.diferenciaNeta > 0 ? 'Sobre-dotación neta' : 'Dotación exacta')) : 'Diferencia respecto a dotación' %>
                    </small>
                </div>
                <div class="stat-icon <%= tipoReporte === 'comparativa' ? (totales.diferenciaNeta < 0 ? 'bg-danger-subtle text-danger' : (totales.diferenciaNeta > 0 ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success')) : 'bg-danger-subtle text-danger' %>">
                    <i class="bi <%= tipoReporte === 'comparativa' ? (totales.diferenciaNeta < 0 ? 'bi-arrow-down-right-circle-fill' : (totales.diferenciaNeta > 0 ? 'bi-arrow-up-right-circle-fill' : 'bi-check-circle-fill')) : 'bi-person-dash-fill' %>"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card stat-success">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">% Cobertura Real</span>
                    <h3 class="fw-bold my-1 text-success"><%= totales.porcentajeCobertura %>%</h3>
                    <small class="text-muted">Cumplimiento de plantilla</small>
                </div>
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- PESTAÑA: COMPARATIVA PLANTILLA VS ASISTENCIA REAL                         -->
<!-- ========================================================================= -->
<% if (tipoReporte === 'comparativa') { %>

    <!-- Mini-Panel de Diagnóstico Rápido de Cargos -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded-3 bg-white shadow-sm d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success fs-4 p-2 rounded-circle"><i class="bi bi-check2-circle"></i></span>
                <div>
                    <h5 class="fw-bold mb-0 text-success"><%= totales.puestosCompletos || 0 %></h5>
                    <small class="text-muted fw-semibold">Cargos Completos (100%)</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded-3 bg-white shadow-sm d-flex align-items-center gap-3">
                <span class="badge bg-danger-subtle text-danger fs-4 p-2 rounded-circle"><i class="bi bi-exclamation-triangle"></i></span>
                <div>
                    <h5 class="fw-bold mb-0 text-danger"><%= totales.puestosDeficit || 0 %></h5>
                    <small class="text-muted fw-semibold">Con Faltantes / Déficit</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded-3 bg-white shadow-sm d-flex align-items-center gap-3">
                <span class="badge bg-primary-subtle text-primary fs-4 p-2 rounded-circle"><i class="bi bi-arrow-up-circle"></i></span>
                <div>
                    <h5 class="fw-bold mb-0 text-primary"><%= totales.puestosExcedente || 0 %></h5>
                    <small class="text-muted fw-semibold">Con Excedente (>100%)</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 border rounded-3 bg-white shadow-sm d-flex align-items-center gap-3">
                <span class="badge bg-secondary-subtle text-secondary fs-4 p-2 rounded-circle"><i class="bi bi-person-x"></i></span>
                <div>
                    <h5 class="fw-bold mb-0 text-secondary"><%= totales.puestosSinAsistencia || 0 %></h5>
                    <small class="text-muted fw-semibold">Sin Asistencia (0 pers.)</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico Comparativo de Barras: Plantilla vs Asistencia -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bar-chart-line-fill text-primary me-2"></i> Comparativa por Área: Plantilla Contratada vs Asistencia Real
                </h5>
                <small class="text-muted">Evaluación simultánea de personal esperado vs personal asistente por área en la fecha <%= fechaDiario %></small>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="bi bi-calendar-check me-1 text-primary"></i> <%= fechaDiario %>
            </span>
        </div>
        <div class="card-body p-3">
            <% if (chartData && chartData.labels && chartData.labels.length > 0) { %>
                <div style="position: relative; height: 320px;">
                    <canvas id="chartComparativaCanvas"></canvas>
                </div>
            <% } else { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    No hay datos suficientes para graficar la comparativa de esta fecha.
                </div>
            <% } %>
        </div>
    </div>

    <!-- Tabla Comparativa Detallada -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-table text-primary me-2"></i> Detalle Comparativo por Cargo y Puesto
                </h5>
                <small class="text-muted">Comparación puesto a puesto entre la plantilla autorizada y la presencia real en campo</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-teal-subtle text-teal border border-teal-subtle px-3 py-1 fw-bold">Plantilla: <%= totales.totalContratados %></span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-bold">Asistieron: <%= totales.personas %></span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Área Operativa</th>
                            <th>Cargo / Puesto</th>
                            <th class="text-center">Plantilla Contratada</th>
                            <th class="text-center">Personal que Asistió</th>
                            <th class="text-center">Diferencia (Variación)</th>
                            <th class="text-center" style="min-width: 170px;">% Cobertura</th>
                            <th class="pe-4 text-center">Estado Semáforo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% data.forEach(function(row) { %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark border"><%= row.area_nombre %></span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6"><%= row.puesto_nombre %></div>
                                        <% if (row.aplica_turnos) { %>
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle small mt-1" style="font-size: 0.7rem;">
                                                <i class="bi bi-clock-history me-1 text-warning"></i>2 Turnos (Día/Noche)
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-light text-muted border small mt-1" style="font-size: 0.7rem;">Turno Único</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-teal border fw-bold fs-6 px-3 py-2">
                                            <%= row.contratada %> pers.
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge <%= row.asistentes > 0 ? 'bg-success' : 'bg-secondary' %> px-3 py-2 fs-6 fw-bold">
                                            <%= row.asistentes %> pers.
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <% if (row.diferencia < 0) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-bold fs-6">
                                                <i class="bi bi-arrow-down-right me-1"></i><%= row.diferencia %>
                                            </span>
                                        <% } else if (row.diferencia === 0) { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold fs-6">
                                                <i class="bi bi-check-lg me-1"></i>0 (Exacto)
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-bold fs-6">
                                                <i class="bi bi-arrow-up-right me-1"></i>+<%= row.diferencia %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="progress flex-grow-1" style="max-width: 90px; height: 8px;">
                                                <div class="progress-bar <%= row.porcentaje >= 100 ? 'bg-success' : (row.porcentaje >= 80 ? 'bg-warning' : 'bg-danger') %>" 
                                                     role="progressbar" 
                                                     style="width: <%= Math.min(100, row.porcentaje) %>%;" 
                                                     aria-valuenow="<%= row.porcentaje %>" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="small fw-bold <%= row.porcentaje >= 100 ? 'text-success' : (row.porcentaje >= 80 ? 'text-warning-emphasis' : 'text-danger') %>">
                                                <%= row.porcentaje %>%
                                            </span>
                                        </div>
                                    </td>
                                    <td class="pe-4 text-center">
                                        <span class="badge <%= row.estadoBadge %> px-3 py-2 fw-bold fs-6">
                                            <%= row.estadoLabel %>
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    No se encontraron puestos o datos para la fecha <%= fechaDiario %>.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                    <% if (data && data.length > 0) { %>
                        <tfoot class="table-light border-top border-2">
                            <tr class="fw-bold">
                                <td colspan="2" class="ps-4 text-uppercase">Gran Total Comparativo:</td>
                                <td class="text-center text-teal fs-6"><%= totales.totalContratados %> pers.</td>
                                <td class="text-center text-success fs-6"><%= totales.personas %> pers.</td>
                                <td class="text-center fs-6 <%= totales.diferenciaNeta < 0 ? 'text-danger' : (totales.diferenciaNeta > 0 ? 'text-primary' : 'text-success') %>">
                                    <%= totales.diferenciaNeta > 0 ? '+' + totales.diferenciaNeta : totales.diferenciaNeta %>
                                </td>
                                <td class="text-center fs-6 text-success"><%= totales.porcentajeCobertura %>%</td>
                                <td class="pe-4 text-center">
                                    <span class="badge <%= totales.porcentajeCobertura >= 100 ? 'bg-success text-white' : (totales.porcentajeCobertura >= 80 ? 'bg-warning text-dark' : 'bg-danger text-white') %> px-3 py-2 fs-6">
                                        <%= totales.porcentajeCobertura >= 100 ? 'Plantilla Completa' : (totales.porcentajeCobertura >= 80 ? 'Déficit Moderado' : 'Déficit Crítico') %>
                                    </span>
                                </td>
                            </tr>
                        </tfoot>
                    <% } %>
                </table>
            </div>
        </div>
    </div>

<!-- ========================================================================= -->
<!-- PESTAÑA: DETALLE POR PUESTOS Y GRÁFICO DE COMPORTAMIENTO TEMPORAL         -->
<!-- ========================================================================= -->
<% } else if (tipoReporte === 'detalle_puesto') { %>

    <!-- Gráfico de Comportamiento Temporal por Puesto -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-graph-up-arrow text-primary me-2"></i> Comportamiento de la Asistencia por Puesto en el Tiempo
                </h5>
                <small class="text-muted">Evolución diaria de asistencia de personal (haz clic en la leyenda para ocultar/mostrar puestos)</small>
            </div>
            <% if (selectedPuestoId && puestosFiltro) { %>
                <% const pActual = puestosFiltro.find(p => p.id_puesto === selectedPuestoId); %>
                <span class="badge bg-primary fs-6 px-3 py-1">
                    <i class="bi bi-person-fill me-1"></i> Puesto: <%= pActual ? pActual.nombre : '' %>
                </span>
            <% } %>
        </div>
        <div class="card-body p-3">
            <% if (chartDataPuestos && chartDataPuestos.datasets && chartDataPuestos.datasets.length > 0) { %>
                <div style="position: relative; height: 320px;">
                    <canvas id="chartPuestosCanvas"></canvas>
                </div>
            <% } else { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                    No se registran datos diarios para los filtros seleccionados en este rango.
                </div>
            <% } %>
        </div>
    </div>

    <!-- Tarjetas de Distribución Rápida (Cuántos Patieros, Punteros, etc.) -->
    <% if (data && data.length > 0 && totales.personas > 0) { %>
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill text-warning me-2"></i> Distribución de Asistentes por Puesto en el Periodo
                </h6>
            </div>
            <div class="card-body p-3">
                <div class="row g-3">
                    <% data.slice(0, 8).forEach(function(row) { 
                        const porcentaje = totales.personas > 0 ? Math.round((row.total_asistencias / totales.personas) * 100) : 0;
                    %>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-light shadow-sm h-100">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark text-truncate" title="<%= row.puesto_nombre %>">
                                        <%= row.puesto_nombre %>
                                    </span>
                                    <span class="badge bg-primary fs-6"><%= row.total_asistencias %></span>
                                </div>
                                <div class="progress mb-2" style="height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: <%= porcentaje %>%;" aria-valuenow="<%= porcentaje %>" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="d-flex justify-content-between text-muted small">
                                    <span><%= porcentaje %>% del total</span>
                                    <span>Promedio: <strong><%= Number(row.promedio_diario).toFixed(1) %>/día</strong></span>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Tabla Detallada por Puesto -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-briefcase-fill text-teal me-2"></i> Resumen Cuantitativo por Puesto de Trabajo
            </h5>
            <span class="badge bg-light text-dark border">Total: <%= totales.personas %> personas sumadas</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Área Operativa</th>
                            <th>Puesto de Trabajo</th>
                            <th class="text-center">Plantilla Contratada</th>
                            <th class="text-center">Total Personas</th>
                            <th class="text-center">% Participación</th>
                            <th class="text-center">Días Registrados</th>
                            <th class="text-center">Promedio Diario</th>
                            <th class="text-center">% Cumplimiento</th>
                            <th class="text-center">Máximo en un Día</th>
                            <th class="pe-4 text-end">Mínimo en un Día</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% data.forEach(function(row) { 
                                const pct = totales.personas > 0 ? ((row.total_asistencias / totales.personas) * 100).toFixed(1) : 0;
                            %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark border"><%= row.area_nombre %></span>
                                    </td>
                                    <td class="fw-bold text-dark fs-6">
                                        <%= row.puesto_nombre %>
                                    </td>
                                    <td class="text-center">
                                        <% if (row.cantidad_contratada > 0) { %>
                                            <span class="badge bg-light text-primary border fw-bold fs-6"><%= row.cantidad_contratada %> pers.</span>
                                        <% } else { %>
                                            <span class="badge bg-light text-muted border">No definida</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success px-3 py-2 fs-6 fw-bold">
                                            <%= row.total_asistencias %> personas
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="progress flex-grow-1" style="max-width: 80px; height: 6px;">
                                                <div class="progress-bar bg-success" style="width: <%= pct %>%;"></div>
                                            </div>
                                            <span class="small fw-semibold text-secondary"><%= pct %>%</span>
                                        </div>
                                    </td>
                                    <td class="text-center"><%= row.dias_registrados %> días</td>
                                    <td class="text-center fw-semibold text-primary"><%= Number(row.promedio_diario).toFixed(1) %> pers/día</td>
                                    <td class="text-center">
                                        <% if (row.cobertura !== null) { %>
                                            <span class="badge <%= row.cobertura >= 100 ? 'bg-success-subtle text-success border border-success-subtle' : (row.cobertura >= 80 ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle') %> px-2 py-1 fw-bold">
                                                <%= row.cobertura %>%
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center text-success fw-bold"><%= row.max_dia %></td>
                                    <td class="pe-4 text-end text-muted"><%= row.min_dia %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="10" class="text-center py-5 text-muted">No se encontraron registros de puestos para los filtros especificados.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<!-- ========================================================================= -->
<!-- PESTAÑA: RESUMEN Y EVOLUCIÓN POR ÁREA                                     -->
<!-- ========================================================================= -->
<% } else if (tipoReporte === 'resumen_area') { %>

    <!-- Gráfico Comparativo por Área -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-primary me-2"></i> Evolución de Asistencia Diaria por Área</h5>
        </div>
        <div class="card-body p-3">
            <div style="position: relative; height: 320px;">
                <canvas id="reporteLineChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Tabla de Resumen por Área -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-table text-primary me-2"></i> Totales Acumulados por Área</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Área Operativa</th>
                            <th class="text-center">Total Puestos</th>
                            <th class="text-center">Plantilla Contratada</th>
                            <th class="text-center">Días con Registro</th>
                            <th class="text-center">Total Personas</th>
                            <th class="text-center">Promedio por Puesto</th>
                            <th class="pe-4 text-end">% Cumplimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% data.forEach(function(row) { %>
                                <tr>
                                    <td class="ps-4 fw-bold text-primary"><%= row.area_codigo %></td>
                                    <td class="fw-semibold text-dark"><%= row.area_nombre %></td>
                                    <td class="text-center"><%= row.total_puestos %></td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-teal border fw-bold fs-6"><%= row.total_contratados %> pers.</span>
                                    </td>
                                    <td class="text-center"><%= row.dias_con_registro %></td>
                                    <td class="text-center">
                                        <span class="badge bg-primary px-3 py-2 fs-6 fw-bold"><%= row.total_asistencias %></span>
                                    </td>
                                    <td class="text-center fw-semibold text-secondary">
                                        <%= Number(row.promedio_por_puesto).toFixed(1) %> pers/puesto
                                    </td>
                                    <td class="pe-4 text-end">
                                        <% if (row.cobertura !== null) { %>
                                            <span class="badge <%= row.cobertura >= 100 ? 'bg-success-subtle text-success border border-success-subtle' : (row.cobertura >= 80 ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle') %> px-2 py-1 fw-bold">
                                                <%= row.cobertura %>%
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="8" class="text-center py-4 text-muted">No se encontraron datos para el rango seleccionado.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<!-- ========================================================================= -->
<!-- PESTAÑA: REPORTE DIARIO CONSOLIDADO                                       -->
<!-- ========================================================================= -->
<% } else { %>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-calendar-check-fill text-primary me-2"></i> Reporte Detallado del Día: <%= fechaDiario %>
            </h5>
            <span class="badge bg-primary fs-6 px-3 py-2">Gran Total: <%= totales.personas %> asistentes</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Área / Ubicación</th>
                            <th>Puesto de Trabajo</th>
                            <th class="text-center">Plantilla Contratada</th>
                            <th class="text-center">Asistieron</th>
                            <th class="text-center">Faltantes / Ausencias</th>
                            <th class="text-center">% Cobertura</th>
                            <th>Observaciones</th>
                            <th>Registrado Por</th>
                            <th class="pe-4 text-end">Hora Registro</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% data.forEach(function(row) { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold text-dark"><%= row.area_nombre %></div>
                                        <% if (row.ubicacion_nombre) { %>
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle small mt-1">
                                                <i class="bi bi-geo-alt-fill text-warning me-1"></i><%= row.ubicacion_nombre %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        <%= row.puesto_nombre %>
                                        <% if (row.turno === 'TURNO_1') { %>
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle ms-1" style="font-size: 0.72rem;">
                                                <i class="bi bi-sun-fill text-warning me-1"></i>Turno 1
                                            </span>
                                        <% } else if (row.turno === 'TURNO_2') { %>
                                            <span class="badge bg-info-subtle text-dark border border-info-subtle ms-1" style="font-size: 0.72rem;">
                                                <i class="bi bi-moon-fill text-info me-1"></i>Turno 2
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (row.cantidad_contratada > 0) { %>
                                            <span class="badge bg-light text-teal border fw-bold fs-6"><%= row.cantidad_contratada %></span>
                                        <% } else { %>
                                            <span class="badge bg-light text-muted border">No def.</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge <%= row.cantidad_asistentes > 0 ? 'bg-success' : 'bg-secondary' %> px-3 py-2 fs-6 fw-bold">
                                            <%= row.cantidad_asistentes %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <% if (row.faltantes > 0) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold fs-6">
                                                <i class="bi bi-arrow-down-circle me-1"></i><%= row.faltantes %>
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-light text-success border px-2 py-1 fw-semibold">0</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="progress flex-grow-1" style="max-width: 60px; height: 6px;">
                                                <div class="progress-bar <%= row.cobertura >= 100 ? 'bg-success' : (row.cobertura >= 80 ? 'bg-warning' : 'bg-danger') %>" style="width: <%= Math.min(100, row.cobertura) %>%;"></div>
                                            </div>
                                            <span class="small fw-bold <%= row.cobertura >= 100 ? 'text-success' : (row.cobertura >= 80 ? 'text-warning-emphasis' : 'text-danger') %>"><%= row.cobertura %>%</span>
                                        </div>
                                    </td>
                                    <td class="small text-muted"><%= row.observaciones || '-' %></td>
                                    <td class="small text-muted"><i class="bi bi-person me-1"></i><%= row.registrado_por || 'Sin captura' %></td>
                                    <td class="pe-4 text-end small text-muted">
                                        <i class="bi bi-clock me-1 text-secondary"></i><%= row.hora_registro_texto || (row.fecha_registro ? new Date(row.fecha_registro).toLocaleTimeString('es-ES') : '-') %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="9" class="text-center py-4 text-muted">No se encontraron registros para la fecha <%= fechaDiario %>.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 0. Gráfico Comparativo de Barras: Plantilla vs Asistencia
    <% if (tipoReporte === 'comparativa') { %>
        const canvasComp = document.getElementById('chartComparativaCanvas');
        if (canvasComp) {
            const chartDataComp = <%- JSON.stringify(chartData) %>;
            if (chartDataComp && chartDataComp.labels && chartDataComp.labels.length > 0) {
                new Chart(canvasComp, {
                    type: 'bar',
                    data: chartDataComp,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'Cantidad de Personas' },
                                ticks: { stepSize: 5 }
                            },
                            x: {
                                title: { display: true, text: 'Área Operativa' }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { boxWidth: 14, font: { size: 12, weight: 'bold' } }
                            },
                            tooltip: {
                                padding: 10,
                                cornerRadius: 8
                            }
                        }
                    }
                });
            }
        }
    <% } %>

    // 1. Gráfico de Comportamiento Temporal por Puesto
    <% if (tipoReporte === 'detalle_puesto') { %>
        const canvasPuestos = document.getElementById('chartPuestosCanvas');
        if (canvasPuestos) {
            const chartDataPuestos = <%- JSON.stringify(chartDataPuestos) %>;
            if (chartDataPuestos && chartDataPuestos.labels && chartDataPuestos.labels.length > 0) {
                new Chart(canvasPuestos, {
                    type: 'line',
                    data: chartDataPuestos,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'Cantidad de Personas' },
                                ticks: { stepSize: 1 }
                            },
                            x: {
                                title: { display: true, text: 'Fecha (Día/Mes)' }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { boxWidth: 14, font: { size: 11 } }
                            },
                            tooltip: {
                                padding: 10,
                                cornerRadius: 8
                            }
                        }
                    }
                });
            }
        }
    <% } %>

    // 2. Gráfico por Área
    <% if (tipoReporte === 'resumen_area') { %>
        const canvasArea = document.getElementById('reporteLineChart');
        if (canvasArea) {
            const chartConfig = <%- JSON.stringify(chartData) %>;
            if (chartConfig && chartConfig.labels && chartConfig.labels.length > 0) {
                new Chart(canvasArea, {
                    type: 'line',
                    data: chartConfig,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'Cantidad de Asistentes' }
                            },
                            x: {
                                title: { display: true, text: 'Fecha' }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                            }
                        }
                    }
                });
            }
        }
    <% } %>
});
</script>
